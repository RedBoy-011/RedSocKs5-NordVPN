#!/usr/bin/env bash
set -euo pipefail
echo '=== RedSocKs5-NordVPN ==='
if [[ "${EUID}" -ne 0 ]]; then echo 'Please run as root: sudo ./RedSocKs5'; exit 1; fi
source /etc/os-release
case "${ID:-}" in ubuntu|debian) ;; *) echo "Unsupported OS: ${ID:-unknown}. Ubuntu/Debian required."; exit 1;; esac
apt-get update -y
apt-get install -y ca-certificates curl sudo

install_nordvpn_cli() {
  if ! command -v nordvpn >/dev/null 2>&1; then
    echo 'Installing official NordVPN Linux CLI...'
    sh <(curl -fsSL https://downloads.nordcdn.com/apps/linux/install.sh)
  fi
  systemctl enable --now nordvpnd 2>/dev/null || true
}

install_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo 'Installing Docker Engine and Compose plugin...'
    apt-get install -y docker.io docker-compose-plugin
    systemctl enable --now docker
  elif ! docker compose version >/dev/null 2>&1; then
    apt-get install -y docker-compose-plugin
  fi
  modprobe tun 2>/dev/null || true
}

echo '1) Token (official NordVPN CLI: one active system-wide location)'
echo '2) Service credentials (multi-location Docker/SOCKS5)'
read -rp 'Authentication mode [1/2]: ' mode
if [[ "${mode:-1}" == "1" ]]; then
  install_nordvpn_cli
  read -rsp 'NordVPN access token: ' token; echo
  read -rp 'Country (e.g. Germany): ' country
  read -rp 'Local SOCKS port [1081]: ' port; port=${port:-1081}
  nordvpn login --token "$token"
  nordvpn connect "$country"
  echo "Connected to $country with official CLI."
  echo 'Token mode supports one active VPN route; five simultaneous SOCKS locations require mode 2.'
  echo "Selected panel port: 127.0.0.1:$port (configure a SOCKS daemon separately)."
  exit 0
fi
[[ "${mode:-}" == "2" ]] || { echo 'Invalid mode.'; exit 1; }
install_docker
read -rp 'NordVPN service username: ' user
read -rsp 'NordVPN service password: ' pass; echo
read -rp 'Number of locations (1-5) [5]: ' count; count=${count:-5}
[[ "$count" =~ ^[1-5]$ ]] || { echo 'Count must be 1..5'; exit 1; }
keys=(DE GR BG RO AT); defaults=(Germany Greece Bulgaria Romania Austria); ports=(1081 1082 1083 1084 1085)
read -rp 'Use automatic nearby-country selection? [Y/n]: ' auto
auto=${auto:-Y}
{
  printf 'NORDVPN_USERNAME=%s\nNORDVPN_PASSWORD=%s\n' "$user" "$pass"
  for ((i=0;i<count;i++)); do
    if [[ "$auto" =~ ^[Yy]$ ]]; then
      country=${defaults[$i]}
      echo "Auto-selected ${keys[$i]}: $country"
    else
      read -rp "Country ${keys[$i]} [${defaults[$i]}]: " country; country=${country:-${defaults[$i]}}
    fi
    read -rp "Fixed SOCKS port ${keys[$i]} [${ports[$i]}]: " port; port=${port:-${ports[$i]}}
    printf 'LOC_%s=%s\nPORT_%s=%s\n' "${keys[$i]}" "$country" "${keys[$i]}" "$port"
  done
  echo 'TZ=Europe/Istanbul'
} > .env
chmod 600 .env
docker compose up -d
docker compose ps
